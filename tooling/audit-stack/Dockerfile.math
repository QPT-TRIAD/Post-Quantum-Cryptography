# Reproducible MATHEMATICS layer only (item 4 of the next sequence): SymPy + galois engines.
#   docker build -t qpt128-math:0.1 -f Dockerfile.math .
#   docker run --rm -v /path/to/PQT:/src:ro -e PQT_SRC=/src -v "$PWD/math:/audit/math" qpt128-math:0.1
# (/src is where the layer's read-only research tree is mounted; the layer reads it through the
#  environment variable PQT_SRC, so any host directory may be mounted there — see the domain's
#  docs/inputs-and-provenance.md.)
# Reproduces: CFHL 81.74 / 252.40, multi-target crossover T = 2^36, dim ker D <= 2, Grover slope ~0.5,
# multi-target slopes ~(-1, 0, -0.5), toy-FRAME slope ~1, quorum threshold 22 — from the frozen sources.
FROM python:3.12-slim
RUN pip install --no-cache-dir sympy==1.14.0 galois==0.4.11 numba==0.61.2 numpy==2.2.6 \
 && (pip install --no-cache-dir passagemath-standard >/dev/null 2>&1 && echo "passagemath (SageMath) installed" || echo "passagemath not installed; SymPy/galois are the engines")
WORKDIR /audit
COPY math/math_layer.py /audit/math/math_layer.py
ENTRYPOINT ["python3", "/audit/math/math_layer.py"]
