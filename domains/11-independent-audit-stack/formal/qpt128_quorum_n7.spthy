    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s2', K, v), !Vote('s4', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's2', 's4', 's6'), Verified('s0', K, v), Verified('s1', K, v), Verified('s2', K, v), Verified('s4', K, v), Verified('s6', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's2'), !CertSig(~c, K, v, 's4'), !CertSig(~c, K, v, 's6') ]
rule Accept_01256:
    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s2', K, v), !Vote('s5', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's2', 's5', 's6'), Verified('s0', K, v), Verified('s1', K, v), Verified('s2', K, v), Verified('s5', K, v), Verified('s6', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's2'), !CertSig(~c, K, v, 's5'), !CertSig(~c, K, v, 's6') ]
rule Accept_01345:
    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s3', K, v), !Vote('s4', K, v), !Vote('s5', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's3', 's4', 's5'), Verified('s0', K, v), Verified('s1', K, v), Verified('s3', K, v), Verified('s4', K, v), Verified('s5', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's3'), !CertSig(~c, K, v, 's4'), !CertSig(~c, K, v, 's5') ]
rule Accept_01346:
    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s3', K, v), !Vote('s4', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's3', 's4', 's6'), Verified('s0', K, v), Verified('s1', K, v), Verified('s3', K, v), Verified('s4', K, v), Verified('s6', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's3'), !CertSig(~c, K, v, 's4'), !CertSig(~c, K, v, 's6') ]
rule Accept_01356:
    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s3', K, v), !Vote('s5', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's3', 's5', 's6'), Verified('s0', K, v), Verified('s1', K, v), Verified('s3', K, v), Verified('s5', K, v), Verified('s6', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's3'), !CertSig(~c, K, v, 's5'), !CertSig(~c, K, v, 's6') ]
rule Accept_01456:
    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s4', K, v), !Vote('s5', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's4', 's5', 's6'), Verified('s0', K, v), Verified('s1', K, v), Verified('s4', K, v), Verified('s5', K, v), Verified('s6', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's4'), !CertSig(~c, K, v, 's5'), !CertSig(~c, K, v, 's6') ]
rule Accept_02345:
    [ !Vote('s0', K, v), !Vote('s2', K, v), !Vote('s3', K, v), !Vote('s4', K, v), !Vote('s5', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's2', 's3', 's4', 's5'), Verified('s0', K, v), Verified('s2', K, v), Verified('s3', K, v), Verified('s4', K, v), Verified('s5', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's2'), !CertSig(~c, K, v, 's3'), !CertSig(~c, K, v, 's4'), !CertSig(~c, K, v, 's5') ]
rule Accept_02346:
    [ !Vote('s0', K, v), !Vote('s2', K, v), !Vote('s3', K, v), !Vote('s4', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's2', 's3', 's4', 's6'), Verified('s0', K, v), Verified('s2', K, v), Verified('s3', K, v), Verified('s4', K, v), Verified('s6', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's2'), !CertSig(~c, K, v, 's3'), !CertSig(~c, K, v, 's4'), !CertSig(~c, K, v, 's6') ]
rule Accept_02356:
    [ !Vote('s0', K, v), !Vote('s2', K, v), !Vote('s3', K, v), !Vote('s5', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's2', 's3', 's5', 's6'), Verified('s0', K, v), Verified('s2', K, v), Verified('s3', K, v), Verified('s5', K, v), Verified('s6', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's2'), !CertSig(~c, K, v, 's3'), !CertSig(~c, K, v, 's5'), !CertSig(~c, K, v, 's6') ]
rule Accept_02456:
    [ !Vote('s0', K, v), !Vote('s2', K, v), !Vote('s4', K, v), !Vote('s5', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's2', 's4', 's5', 's6'), Verified('s0', K, v), Verified('s2', K, v), Verified('s4', K, v), Verified('s5', K, v), Verified('s6', K, v) ]->
