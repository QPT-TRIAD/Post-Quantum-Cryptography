/*
 * QPT-128 / CE-QS profile B0 -- SECOND abstraction (ideal authenticated votes)
 * N = 7, q = 5, 2q-N = 3.   GENERATED by gen_n7_votes.py -- do not edit.
 *
 * Signatures are abstracted as authenticated vote facts !Vote(s,K,v) that only
 * seat s (honestly, one candidate per K) or the adversary holding a corrupted
 * seat can create.  A certificate is any 5-subset of the 7 seats; the 21
 * subsets are explicit rules.  Lemmas A..E as in qpt128_quorum.spthy with the
 * threshold constant 3.
 */

theory QPT128_Quorum_N7_q5_Votes
begin

// One registration rule per seat: the seat universe is fixed by construction
// (no seat-name disjunction for Tamarin to case-split at every Register node).
rule Register_0:
    [ ]
  --[ Register('s0'), OnlyOnce(<'reg', 's0'>) ]->
    [ !Seat('s0') ]

rule Register_1:
    [ ]
  --[ Register('s1'), OnlyOnce(<'reg', 's1'>) ]->
    [ !Seat('s1') ]

rule Register_2:
    [ ]
  --[ Register('s2'), OnlyOnce(<'reg', 's2'>) ]->
    [ !Seat('s2') ]

rule Register_3:
    [ ]
  --[ Register('s3'), OnlyOnce(<'reg', 's3'>) ]->
    [ !Seat('s3') ]

rule Register_4:
    [ ]
  --[ Register('s4'), OnlyOnce(<'reg', 's4'>) ]->
    [ !Seat('s4') ]

rule Register_5:
    [ ]
  --[ Register('s5'), OnlyOnce(<'reg', 's5'>) ]->
    [ !Seat('s5') ]

rule Register_6:
    [ ]
  --[ Register('s6'), OnlyOnce(<'reg', 's6'>) ]->
    [ !Seat('s6') ]


restriction OnlyOnce:
  "All x #i #j. OnlyOnce(x)@i & OnlyOnce(x)@j ==> #i = #j"

rule Corrupt:
    [ !Seat($s) ]
  --[ Corrupt($s) ]->
    [ !Corrupted($s) ]

// honest vote: one candidate per coordinate
rule Vote_honest:
    [ !Seat($s), In(<K, v>) ]
  --[ Signed($s, K, v) ]->
    [ !Vote($s, K, v) ]

restriction HonestSignsOneCandidatePerCoordinate:
  "All s K v1 v2 #i #j. Signed(s, K, v1)@i & Signed(s, K, v2)@j ==> v1 = v2"

// adversary vote in the name of a corrupted seat: anything, any time
rule Vote_adversary:
    [ !Corrupted($s), In(<K, v>) ]
  --[ AdvSigned($s, K, v) ]->
    [ !Vote($s, K, v) ]

rule Accept_01234:
    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s2', K, v), !Vote('s3', K, v), !Vote('s4', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's2', 's3', 's4'), Verified('s0', K, v), Verified('s1', K, v), Verified('s2', K, v), Verified('s3', K, v), Verified('s4', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's2'), !CertSig(~c, K, v, 's3'), !CertSig(~c, K, v, 's4') ]
rule Accept_01235:
    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s2', K, v), !Vote('s3', K, v), !Vote('s5', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's2', 's3', 's5'), Verified('s0', K, v), Verified('s1', K, v), Verified('s2', K, v), Verified('s3', K, v), Verified('s5', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's2'), !CertSig(~c, K, v, 's3'), !CertSig(~c, K, v, 's5') ]
rule Accept_01236:
    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s2', K, v), !Vote('s3', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's2', 's3', 's6'), Verified('s0', K, v), Verified('s1', K, v), Verified('s2', K, v), Verified('s3', K, v), Verified('s6', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's2'), !CertSig(~c, K, v, 's3'), !CertSig(~c, K, v, 's6') ]
rule Accept_01245:
    [ !Vote('s0', K, v), !Vote('s1', K, v), !Vote('s2', K, v), !Vote('s4', K, v), !Vote('s5', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's1', 's2', 's4', 's5'), Verified('s0', K, v), Verified('s1', K, v), Verified('s2', K, v), Verified('s4', K, v), Verified('s5', K, v) ]->
    [ !CertSig(~c, K, v, 's0'), !CertSig(~c, K, v, 's1'), !CertSig(~c, K, v, 's2'), !CertSig(~c, K, v, 's4'), !CertSig(~c, K, v, 's5') ]
