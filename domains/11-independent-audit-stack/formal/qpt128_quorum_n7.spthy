rule Accept_03456:
    [ !Vote('s0', K, v), !Vote('s3', K, v), !Vote('s4', K, v), !Vote('s5', K, v), !Vote('s6', K, v), Fr(~c) ]
  --[ Accept(~c, K, v), Signers(~c, 's0', 's3', 's4', 's5', 's6'), Verified('s0', K, v), Verified('s3', K, v), Verified('s4', K, v), Verified('s5', K, v), Verified('s6', K, v) ]->
