   !Signer( ~c, 's1', sign(<K, v, 's1'>, skB) ),
   !Signer( ~c, 's3', sign(<K, v, 's3'>, skC) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Accept_023[no_derivcheck]:
   [
   !Pk( 's0', pk(skA) ), !Pk( 's2', pk(skB) ), !Pk( 's3', pk(skC) ),
   In( <K, v, sign(<K, v, 's0'>, skA), sign(<K, v, 's2'>, skB), 
