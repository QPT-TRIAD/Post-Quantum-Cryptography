theory QPT128_Quorum_N4_q3

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Register:
   [ Fr( ~sk ) ]
  --[ Register( $s ), OnlyOnce( <'reg', $s> ) ]->
   [ !Seat( $s, ~sk ), !Pk( $s, pk(~sk) ), Out( pk(~sk) ) ]

  /* has exactly the trivial AC variant */

restriction SeatUniverse:
  "∀ s #i.
    (Register( s ) @ #i) ⇒
    ((((s = 's0') ∨ (s = 's1')) ∨ (s = 's2')) ∨ (s = 's3'))"
  // safety formula

  /*
  expanded formula:
  "∀ s #i.
    (Register( s ) @ #i) ⇒
    ((((s = 's0') ∨ (s = 's1')) ∨ (s = 's2')) ∨ (s = 's3'))"
  */

restriction OnlyOnce:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) Corrupt:
   [ !Seat( $s, ~sk ) ] --[ Corrupt( $s ) ]-> [ Out( ~sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign:
   [ !Seat( $s, ~sk ), In( <K, v> ) ]
  --[ Signed( $s, K, v ) ]->
   [ Out( sign(<K, v, $s>, ~sk) ) ]

  /* has exactly the trivial AC variant */

restriction HonestSignsOneCandidatePerCoordinate:
  "∀ s K v1 v2 #i #j.
    ((Signed( s, K, v1 ) @ #i) ∧ (Signed( s, K, v2 ) @ #j)) ⇒ (v1 = v2)"
  // safety formula

  /*
  expanded formula:
  "∀ s K v1 v2 #i #j.
    ((Signed( s, K, v1 ) @ #i) ∧ (Signed( s, K, v2 ) @ #j)) ⇒ (v1 = v2)"
  */

rule (modulo E) Accept_012[no_derivcheck]:
   [
   !Pk( 's0', pk(skA) ), !Pk( 's1', pk(skB) ), !Pk( 's2', pk(skC) ),
   In( <K, v, sign(<K, v, 's0'>, skA), sign(<K, v, 's1'>, skB), 
        sign(<K, v, 's2'>, skC)>
   ),
   Fr( ~c )
   ]
  --[
  Accept( ~c, K, v ), Signers( ~c, 's0', 's1', 's2' ),
  Verified( 's0', K, v ), Verified( 's1', K, v ), Verified( 's2', K, v )
  ]->
   [
   !Cert( ~c, K, v ), !Signer( ~c, 's0', sign(<K, v, 's0'>, skA) ),
   !Signer( ~c, 's1', sign(<K, v, 's1'>, skB) ),
   !Signer( ~c, 's2', sign(<K, v, 's2'>, skC) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Accept_013[no_derivcheck]:
   [
   !Pk( 's0', pk(skA) ), !Pk( 's1', pk(skB) ), !Pk( 's3', pk(skC) ),
   In( <K, v, sign(<K, v, 's0'>, skA), sign(<K, v, 's1'>, skB), 
        sign(<K, v, 's3'>, skC)>
   ),
   Fr( ~c )
   ]
  --[
  Accept( ~c, K, v ), Signers( ~c, 's0', 's1', 's3' ),
  Verified( 's0', K, v ), Verified( 's1', K, v ), Verified( 's3', K, v )
