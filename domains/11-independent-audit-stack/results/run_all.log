lemma A_acceptance_authorized:
  all-traces
  "∀ c K v #i.
    (Accept( c, K, v ) @ #i) ⇒
    (∃ a1 a2 a3.
      (((((((((Signers( c, a1, a2, a3 ) @ #i) ∧ (Verified( a1, K, v ) @ #i)) ∧
             (Verified( a2, K, v ) @ #i)) ∧
            (Verified( a3, K, v ) @ #i)) ∧
           (¬(a1 = a2))) ∧
          (¬(a1 = a3))) ∧
         (¬(a2 = a3))) ∧
        ((∃ #k. (Signed( a1, K, v ) @ #k) ∧ (#k < #i)) ∨
         (∃ #k. (Corrupt( a1 ) @ #k) ∧ (#k < #i)))) ∧
       ((∃ #k. (Signed( a2, K, v ) @ #k) ∧ (#k < #i)) ∨
        (∃ #k. (Corrupt( a2 ) @ #k) ∧ (#k < #i)))) ∧
      ((∃ #k. (Signed( a3, K, v ) @ #k) ∧ (#k < #i)) ∨
       (∃ #k. (Corrupt( a3 ) @ #k) ∧ (#k < #i))))"
/*
guarded formula characterizing all counter-examples:
"∃ c K v #i.
  (Accept( c, K, v ) @ #i)
 ∧
  ∀ a1 a2 a3.
   (Signers( c, a1, a2, a3 ) @ #i) ∧
   (Verified( a1, K, v ) @ #i) ∧
   (Verified( a2, K, v ) @ #i) ∧
   (Verified( a3, K, v ) @ #i)
  ⇒
   ((a1 = a2) ∨
    (a1 = a3) ∨
    (a2 = a3) ∨
    ((∀ #k. (Signed( a1, K, v ) @ #k) ⇒ ¬(#k < #i)) ∧
     (∀ #k. (Corrupt( a1 ) @ #k) ⇒ ¬(#k < #i))) ∨
    ((∀ #k. (Signed( a2, K, v ) @ #k) ⇒ ¬(#k < #i)) ∧
     (∀ #k. (Corrupt( a2 ) @ #k) ⇒ ¬(#k < #i))) ∨
    ((∀ #k. (Signed( a3, K, v ) @ #k) ⇒ ¬(#k < #i)) ∧
     (∀ #k. (Corrupt( a3 ) @ #k) ⇒ ¬(#k < #i))))"
*/
