   !Cert( ~c, K, v ), !Signer( ~c, 's1', sign(<K, v, 's1'>, skA) ),
   !Signer( ~c, 's2', sign(<K, v, 's2'>, skB) ),
   !Signer( ~c, 's3', sign(<K, v, 's3'>, skC) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Extract:
   [
   !Cert( c1, K, v1 ), !Cert( c2, K, v2 ), !Signer( c1, s, sig1 ),
   !Signer( c2, s, sig2 )
   ]
  --[ Evidence( s, K, v1, v2 ), Neq( v1, v2 ) ]->
   [ !SlashProof( s, K, v1, v2, sig1, sig2 ) ]

  /* has exactly the trivial AC variant */

restriction Neq:
  "∀ x y #i. (Neq( x, y ) @ #i) ⇒ (¬(x = y))"
  // safety formula

