   ),
   Fr( ~c )
   ]
  --[
  Accept( ~c, K, v ), Signers( ~c, 's1', 's2', 's3' ),
  Verified( 's1', K, v ), Verified( 's2', K, v ), Verified( 's3', K, v )
  ]->
