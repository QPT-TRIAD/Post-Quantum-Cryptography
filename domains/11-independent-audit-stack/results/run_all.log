                (∀ #k. (Corrupt( 's3' ) @ #k) ⇒ ¬(#k < #i))) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        next
          case case_3
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
qed

lemma D2_intersection_seats_corrupt [reuse]:
  all-traces
  "∀ s c1 c2 K v1 v2 #i #j.
    (((((Accept( c1, K, v1 ) @ #i) ∧ (Accept( c2, K, v2 ) @ #j)) ∧
       (¬(v1 = v2))) ∧
      (Verified( s, K, v1 ) @ #i)) ∧
     (Verified( s, K, v2 ) @ #j)) ⇒
    (∃ #k. (Corrupt( s ) @ #k) ∧ ((#k < #i) ∨ (#k < #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ s c1 c2 K v1 v2 #i #j.
  (Accept( c1, K, v1 ) @ #i) ∧
  (Accept( c2, K, v2 ) @ #j) ∧
  (Verified( s, K, v1 ) @ #i) ∧
  (Verified( s, K, v2 ) @ #j)
 ∧
  (¬(v1 = v2)) ∧ (∀ #k. (Corrupt( s ) @ #k) ⇒ (¬(#k < #i)) ∧ (¬(#k < #j)))"
*/
simplify
solve( (∃ #k. (Signed( s, K, v1 ) @ #k) ∧ #k < #i)  ∥
       (∃ #k. (Corrupt( s ) @ #k) ∧ #k < #i) )
  case case_1
  solve( (∃ #k. (Signed( $s, K, v2 ) @ #k) ∧ #k < #j)  ∥
         (∃ #k. (Corrupt( $s ) @ #k) ∧ #k < #j) )
    case case_1
    by contradiction /* from formulas */
  next
    case case_2
    by contradiction /* from formulas */
  qed
next
  case case_2
  by contradiction /* from formulas */
qed

