+
+/// Layer with 2^k columns. Column j is the product of original leaves whose bit
+/// index is j modulo 2^k. At k=0 this is the root; at k=6 these are all 64 leaves.
+/// Padding rows have exponent zero and therefore contribute multiplicative one.
+pub(super) fn b_layer<A, F, P>(
+    alloc: &A, bases: FieldSlice<'_, P>, exponents: &[Word], k: usize,
+) -> FieldVec<P, A>
+where A: Allocator, F: Field, P: PackedField<Scalar=F> {
+    assert!(k <= Word::LOG_BITS);
+    let n = bases.log_len();
+    assert!(exponents.len() <= 1 << n);
+    if k == Word::LOG_BITS {
+        return compute_b_leaves(alloc, bases, exponents);
+    }
+    let height = 1 << k;
+    let mut out = FieldBuffer::zeros_in(alloc, n + k);
+    if n < P::LOG_WIDTH {
+        for i in 0..1 << n {
+            let exp = exponents.get(i).copied().unwrap_or(Word::ZERO);
+            let mut values = [F::ONE; Word::BITS];
+            let mut base = bases.get(i);
+            for z in 0..Word::BITS {
+                let mask = F::make_mask(iter::once(exp.extract_bit(z)));
+                values[z & (height-1)] *= F::ONE + (base-F::ONE).select(&mask);
+                base = base.square();
+            }
+            for (j, value) in values[..height].iter().enumerate() {
+                out.set((j << n) + i, *value);
+            }
+        }
+        return out;
+    }
+    let n_packed = bases.as_ref().len();
+    let mut strided = StridedArray2DViewMut::without_stride(out.as_mut(), height, n_packed)
+        .expect("layer dimensions");
+    let one = P::broadcast(F::ONE);
+    (strided.par_iter_cols(), bases.as_ref()).into_par_iter().enumerate()
+        .for_each(|(packed_index, (mut col, &base))| {
+            let start = (packed_index * P::WIDTH).min(exponents.len());
+            let exp = &exponents[start..(start + P::WIDTH).min(exponents.len())];
+            let mut values = [one; Word::BITS];
+            let mut power = base;
+            for z in 0..Word::BITS {
+                let mask = P::make_mask(exp.iter().map(|x| x.extract_bit(z)));
+                values[z & (height-1)] *= one + (power-one).select(&mask);
+                power = power.square();
+            }
+            for j in 0..height { col[j] = values[j]; }
+        });
+    out
+}
+
+/// Evaluate all 64 original leaf columns at x without retaining the leaf table.
+/// Only the equality tensor over the row dimension and 64 packed accumulators
+/// per parallel worker are required beyond the bases and exponent columns.
+pub(super) fn leaf_evals<A, F, P>(
+    _alloc: &A, bases: FieldSlice<'_, P>, exponents: &[Word], x: &[F],
+) -> Vec<F>
+where A: Allocator, F: Field, P: PackedField<Scalar=F> {
+    assert_eq!(bases.log_len(), x.len());
+    let tensor = eq_ind_partial_eval::<P>(x);
+    if x.len() < P::LOG_WIDTH {
+        let mut sums = [F::ZERO; Word::BITS];
+        for i in 0..1 << x.len() {
+            let mut base = bases.get(i);
+            let exp = exponents.get(i).copied().unwrap_or(Word::ZERO);
+            for (z, sum) in sums.iter_mut().enumerate() {
+                let mask = F::make_mask(iter::once(exp.extract_bit(z)));
+                *sum += tensor.get(i) * (F::ONE + (base-F::ONE).select(&mask));
+                base = base.square();
+            }
+        }
+        return sums.to_vec();
+    }
+    let zero = P::broadcast(F::ZERO);
+    let one = P::broadcast(F::ONE);
+    let sums = (bases.as_ref(), tensor.as_ref()).into_par_iter().enumerate()
+        .fold(|| [zero; Word::BITS], |mut sums, (packed_index, (&base, &weight))| {
+            let start = (packed_index * P::WIDTH).min(exponents.len());
+            let exp = &exponents[start..(start + P::WIDTH).min(exponents.len())];
+            let mut power = base;
+            for (z, sum) in sums.iter_mut().enumerate() {
+                let mask = P::make_mask(exp.iter().map(|x| x.extract_bit(z)));
+                *sum += weight * (one + (power-one).select(&mask));
+                power = power.square();
+            }
+            sums
+        })
+        .reduce(|| [zero; Word::BITS], |mut a, b| {
+            for (a, b) in a.iter_mut().zip(b) { *a += b; }
+            a
+        });
+    sums.into_iter().map(|p| p.iter().sum()).collect()
+}
+
+impl<'alloc, A, F, P, Channel> IntMulProver<'_, 'alloc, A, P, Channel>
+where
+    A: Allocator,
+    F: BinaryField<Underlier: Divisible<u64>>,
+    P: PackedField<Scalar=F>,
+    Channel: IOPProverChannel<P, A>,
+{
+    pub fn prove_recomputing(&mut self, columns: [&[Word]; 4]) -> Result<IntMulOutput<F>, Error> {
+        let [a, b, c_lo, c_hi] = columns;
+        if [b, c_lo, c_hi].iter().any(|x| x.len() != a.len()) {
+            return Err(Error::ExponentLengthMismatch);
+        }
+        let n = log2_ceil_usize(a.len());
+        let alloc = self.alloc;
+        if n >= 20 { eprintln!("IntMul: build fixed-base roots"); }
+        let mut base = F::MULTIPLICATIVE_GENERATOR;
+        let tables: Vec<FieldVec<P, A>> = (0..2*N_LIMBS).map(|_| {
+            let table = power_table::<F, P>(LIMB_BITS, base);
+            for _ in 0..LIMB_BITS { base = base.square(); }
+            FieldBuffer::from_view_in(alloc, table.as_view())
+        }).collect();
+        let (a_prodcheck, a_root) = ProdcheckProver::new(LOG_N_LIMBS, alloc,
+            limb_leaves(alloc, &tables[..N_LIMBS], a));
+        drop(a_prodcheck);
+        let (c_lo_prodcheck, c_lo_root) = ProdcheckProver::new(LOG_N_LIMBS, alloc,
+            limb_leaves(alloc, &tables[..N_LIMBS], c_lo));
+        drop(c_lo_prodcheck);
+        let (c_hi_prodcheck, c_hi_root) = ProdcheckProver::new(LOG_N_LIMBS, alloc,
+            limb_leaves(alloc, &tables[N_LIMBS..], c_hi));
+        drop(c_hi_prodcheck);
+
+        if n >= 20 { eprintln!("IntMul: variable-base product reduction"); }
+        let initial_eval_point = self.channel.sample_many(n);
+        let exp_eval = evaluate_inplace(b_layer(alloc, a_root.as_view(), b, 0), &initial_eval_point);
+        self.channel.send_one(exp_eval);
+        let Phase1Output { eval_point: phase1_eval_point, b_leaves_evals } =
+            self.phase1_recomputing(&initial_eval_point, a_root.as_view(), b, exp_eval);
+        let Phase2Output { twisted_eval_points, twisted_evals } =
+            frobenius_twist(Word::LOG_BITS, &phase1_eval_point, &b_leaves_evals);
+        if n >= 20 { eprintln!("IntMul: selector reduction"); }
+        let Phase3Output {
+            eval_point: phase3_eval_point, r_ib, b_recomb,
+            gpow_a_eval, gpow_c_lo_eval, gpow_c_hi_eval,
+        } = self.phase3(&twisted_eval_points, &twisted_evals, a_root, b,
+            [c_lo_root, c_hi_root], &initial_eval_point, exp_eval);
+        if n >= 20 { eprintln!("IntMul: rebuild fixed-base product trees"); }
+        let (a_prodcheck, _) = ProdcheckProver::new(LOG_N_LIMBS, alloc,
+            limb_leaves(alloc, &tables[..N_LIMBS], a));
+        let (c_lo_prodcheck, _) = ProdcheckProver::new(LOG_N_LIMBS, alloc,
+            limb_leaves(alloc, &tables[..N_LIMBS], c_lo));
+        let (c_hi_prodcheck, _) = ProdcheckProver::new(LOG_N_LIMBS, alloc,
+            limb_leaves(alloc, &tables[N_LIMBS..], c_hi));
+        let phase4 = self.phase4(&phase3_eval_point,
+            (gpow_a_eval, a_prodcheck), (gpow_c_lo_eval, c_lo_prodcheck),
+            (gpow_c_hi_eval, c_hi_prodcheck), [a, c_lo, c_hi], &tables);
+        if n >= 20 { eprintln!("IntMul: lookup reduction"); }
+        Ok(self.phase5(&phase4, b, &phase3_eval_point, &r_ib, b_recomb,
+            a, c_lo, c_hi, tables[0].as_view()))
+    }
+}
+
+impl<'alloc, A, F, P, Channel> IntMulProver<'_, 'alloc, A, P, Channel>
+where A: Allocator, F: BinaryField, P: PackedField<Scalar=F>, Channel: IPProverChannel<F> {
+    fn phase1_recomputing(&mut self, point: &[F], bases: FieldSlice<'_, P>,
+        exponents: &[Word], root_eval: F) -> Phase1Output<F> {
+        let n = point.len();
+        let mut claim = MultilinearEvalClaim { point: point.to_vec(), eval: root_eval };
+        // This is the original ProdcheckProver::prove message schedule. Only layer
+        // storage changes: generate the current layer and consume it immediately.
+        for k in 1..=Word::LOG_BITS {
+            if n >= 20 { eprintln!("IntMul: variable-base layer {k}/6"); }
+            let layer = b_layer(self.alloc, bases, exponents, k);
+            let prover = bivariate_product_mle::new_split_half(
+                self.alloc, layer, claim.point.clone(), claim.eval);
+            let ProveSingleOutput { multilinear_evals, challenges } =
+                prove_single_mlecheck(prover, self.channel);
+            let [a, b] = multilinear_evals.try_into().expect("two leaf halves");
+            self.channel.send_many(&[a, b]);
+            let r = self.channel.sample();
+            let mut next_point = challenges;
+            next_point.reverse();
+            next_point.push(r);
+            claim = MultilinearEvalClaim { eval: extrapolate_line(a, b, r), point: next_point };
+        }
+        let x = &claim.point[..n];
+        let evals = leaf_evals(self.alloc, bases, exponents, x);
+        self.channel.send_many(&evals);
+        Phase1Output { eval_point: x.to_vec(), b_leaves_evals: evals }
+    }
+}
