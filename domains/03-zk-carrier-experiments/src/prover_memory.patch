+
+    pub fn every_recomputed_layer_and_leaf_evaluation_matches_original() {
+        let alloc = GlobalAllocator;
+        let mut rng = StdRng::seed_from_u64(1701);
+        for n_rows in [1usize, 3, 17, 64] {
+            let n = log2_ceil_usize(n_rows);
+            let bases = FieldBuffer::<P>::from_values(&(0..1 << n)
+                .map(|_| F::random(&mut rng)).collect::<Vec<_>>());
+            let exponents: Vec<_> = (0..n_rows).map(|_| Word(rng.random())).collect();
+            let x: Vec<_> = (0..n).map(|_| F::random(&mut rng)).collect();
+            let original = compute_b_leaves(&alloc, bases.as_view(), &exponents);
+            let evals: Vec<_> = original.chunks(n).map(|leaf| evaluate(&leaf, &x)).collect();
+            assert_eq!(leaf_evals(&alloc, bases.as_view(), &exponents, &x), evals);
+            let mut expected = original;
+            for k in (0..=Word::LOG_BITS).rev() {
+                assert_eq!(b_layer(&alloc, bases.as_view(), &exponents, k), expected,
+                    "layer differs for n_rows={n_rows}, k={k}");
+                if k > 0 {
+                    let (lo, hi) = expected.split_half();
+                    expected = FieldBuffer::from_values(&lo.iter_scalars().zip(hi.iter_scalars())
+                        .map(|(a, b)| a*b).collect::<Vec<_>>());
+                }
+            }
+        }
+    }
+
+    pub fn recomputed_complete_protocol_is_byte_identical_and_verifies() {
+        let alloc = GlobalAllocator;
+        let mut rng = StdRng::seed_from_u64(1702);
+        for rows in [1usize, 3, 5, 32, 33, 129] {
+            let mut columns: [Vec<Word>; 4] = std::array::from_fn(|_| Vec::new());
+            for i in 0..rows {
+                let (a, b) = match i % 5 {
+                    0 => (0, u64::MAX), 1 => (u64::MAX, u64::MAX),
+                    2 => (1 << 63, 1 << 63), _ => (rng.random(), rng.random()),
+                };
+                let product = (a as u128)*(b as u128);
+                for (c, v) in columns.iter_mut().zip([a, b, product as u64, (product >> 64) as u64]) {
+                    c.push(Word(v));
+                }
+            }
+            let refs = columns.each_ref().map(Vec::as_slice);
+            let run = |recompute: bool| {
+                let mut t = ProverTranscript::<StdChallenger>::default();
+                let mut ch = NaiveProverChannel::<F, _>::new(&mut t, vec![OracleSpec::new(LIMB_BITS)]);
+                let mut p = IntMulProver::<_, P, _>::new(0, &mut ch, &alloc);
+                let result = if recompute { p.prove_recomputing(refs).unwrap() }
+                    else { p.prove(Witness::new(&alloc, refs[0], refs[1], refs[2], refs[3]).unwrap()) };
+                ch.finish();
+                (result, t.finalize())
+            };
+            let (eager_claims, eager_bytes) = run(false);
+            let (claims, proof) = run(true);
+            assert_eq!(claims, eager_claims, "claims differ at rows={rows}");
+            assert_eq!(proof, eager_bytes, "transcript differs at rows={rows}");
+            let specs = [OracleSpec::new(LIMB_BITS)];
+            let mut t = VerifierTranscript::new(StdChallenger::default(), proof);
+            let mut ch = NaiveVerifierChannel::new(&mut t, &specs);
+            assert_eq!(verify(log2_ceil_usize(rows), &mut ch).unwrap(), claims);
+            ch.finish();
+        }
+    }
+}
